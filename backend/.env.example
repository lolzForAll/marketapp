# Copy this file to backend/.env and fill in real values.

# Get a key at https://serpapi.com/manage-api-key (used for reverse image
# search / price comps via Google Lens).
SERPAPI_API_KEY=

# A publicly reachable base URL for THIS backend, so SerpApi's servers can
# fetch your uploaded photos. For local development, run a tunnel such as:
#   ngrok http 8000
# and paste the https URL it gives you here, e.g.:
# PUBLIC_BASE_URL=https://abcd-12-34-56-78.ngrok-free.app
# If you deploy the backend somewhere with a real domain, use that instead.
PUBLIC_BASE_URL=

# Optional overrides:
# DATABASE_URL=sqlite:///./marketapp.db
# BROWSER_PROFILE_DIR=./.browser_profile
